post_install() {
    cat <<'MSG'
==> QHealth reads keyboard and mouse events from /dev/input. If you are not
    in the "input" group yet:   sudo usermod -aG input "$USER"   (then log out and in)
==> Start 24/7 tracking for your user:
      systemctl --user enable --now qhealth.service
MSG
}

post_upgrade() {
    echo "==> Restart tracking to load the new version: systemctl --user restart qhealth.service"
}
